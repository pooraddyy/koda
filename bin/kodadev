#!/usr/bin/env bash
set -e
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export koda_DEV_REPO="$dir"
# Find the first non-flag arg. If there isn't one, the user is launching the
# TUI, so point it at the caller's directory via the project positional.
# Otherwise forward args untouched so subcommands (run, dev-alias, ...) don't
# collide with --project (only TUI/stats accept --project under yargs strict).
first=
termux=false
if [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *"/com.termux/"* ]]; then
  termux=true
fi
for a in "$@"; do
  case "$a" in
    --) break ;;
    -*) ;;
    *) first="$a"; break ;;
  esac
done
if [[ -z "$first" ]]; then
  if [[ "$termux" == true ]]; then
    exec bun run --cwd "$dir/packages/opencode" --conditions=node src/index.ts --project "$PWD" --mini
  fi
  exec bun run --cwd "$dir/packages/opencode" --conditions=node src/index.ts --project "$PWD" "$@"
fi
exec bun run --cwd "$dir/packages/opencode" --conditions=node src/index.ts "$@"
